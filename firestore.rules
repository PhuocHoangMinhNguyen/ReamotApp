rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ───────────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function currentEmail() {
      return request.auth.token.email;
    }

    // Checks whether the requesting user appears in the target patient's
    // doctorList or pharmacistList stored in the users collection.
    // Uses the userByEmail/{email} lookup collection to resolve email → UID
    // (users documents are keyed by Firebase Auth UID, not email).
    function isGrantedAccessToPatient(patientEmail) {
      let uidDoc = get(/databases/$(database)/documents/userByEmail/$(patientEmail));
      let patientDoc = get(/databases/$(database)/documents/users/$(uidDoc.data.uid));
      return currentEmail() in patientDoc.data.doctorList
          || currentEmail() in patientDoc.data.pharmacistList;
    }

    // ── userByEmail (email → UID lookup) ──────────────────────────────────────
    // Written once on registration; used by isGrantedAccessToPatient.
    match /userByEmail/{email} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
                    && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // ── users ──────────────────────────────────────────────────────────────────
    // A patient may only read/write their own profile.
    match /users/{userId} {
      allow read, write: if isAuthenticated()
                         && request.auth.uid == userId;
    }

    // ── prescription ──────────────────────────────────────────────────────────
    // A patient can manage their own prescriptions.
    // A doctor/pharmacist who has been granted access may also read them.
    match /prescription/{docId} {
      allow read: if isAuthenticated()
                  && (resource.data.patientEmail == currentEmail()
                      || isGrantedAccessToPatient(resource.data.patientEmail));
      allow write: if isAuthenticated()
                   && request.resource.data.patientEmail == currentEmail();
    }

    // ── reminder ──────────────────────────────────────────────────────────────
    // Split write into create vs update/delete to avoid resource.data error on create.
    match /reminder/{docId} {
      allow read: if isAuthenticated()
                  && resource.data.patientEmail == currentEmail();
      allow create: if isAuthenticated()
                    && request.resource.data.patientEmail == currentEmail();
      allow update, delete: if isAuthenticated()
                            && resource.data.patientEmail == currentEmail();
    }

    // ── history ───────────────────────────────────────────────────────────────
    // Patients write their own history; granted doctors/pharmacists may read it.
    match /history/{docId} {
      allow read: if isAuthenticated()
                  && (resource.data.patientEmail == currentEmail()
                      || isGrantedAccessToPatient(resource.data.patientEmail));
      allow write: if isAuthenticated()
                   && request.resource.data.patientEmail == currentEmail();
    }

    // ── medicine (global catalogue) ───────────────────────────────────────────
    // Any authenticated user may browse and add to the medicine catalogue.
    // Patient-added medicines use adder: 'patient'.
    match /medicine/{docId} {
      allow read:  if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // ── doctor / pharmacist profiles ──────────────────────────────────────────
    // Any authenticated user can look up a professional's public profile.
    // Split write into create vs update/delete to avoid resource.data error on create.
    match /doctor/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
                    && request.resource.data.doctorEmail == currentEmail();
      allow update, delete: if isAuthenticated()
                            && resource.data.doctorEmail == currentEmail();
    }

    match /pharmacist/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
                    && request.resource.data.pharmacistEmail == currentEmail();
      allow update, delete: if isAuthenticated()
                            && resource.data.pharmacistEmail == currentEmail();
    }
  }
}
